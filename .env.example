# ==========================================
# AHMAD BILAL AI AGENCY - EMAIL CONFIGURATION
# ==========================================
# To enable real emails for client proposals:
# 1. Rename or copy this file to `.env.local`
# 2. Fill in your Gmail or SMTP credentials below.
#
# FOR GMAIL USERS:
# - SMTP_USER: Your full Gmail address (e.g. yourname@gmail.com)
# - SMTP_PASS: A 16-character Google App Password (NOT your regular login password!)
#   (Generate it here: Google Account -> Security -> 2-Step Verification -> App Passwords)
#
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Email address where you want to receive new client proposals:
# (If left blank, it defaults to SMTP_USER)
PROPOSAL_RECEIVER_EMAIL=your-email@gmail.com
